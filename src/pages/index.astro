---
import Layout from '../layouts/Layout.astro';
---

<Layout title="sousto">
    <main>
        <section class="intro">
            <h1 class="title">sousto</h1>
            <video autoplay muted loop playsinline aria-hidden="true">
                <source src="/cover.mp4" type="video/mp4" />
            </video>
        </section>
        <section class="manifest">
            <article>
                <h2>manifesto</h2>
                <p>
                    Sousto rozvíjí komunitní život v Táboře pořádáním hudebních akcí. Podporujeme místní DJs i se
                    snažíme představovat místnímu publiku zajímavá jména české klubové scény.
                </p>
                <p>
                    Tábor je náš program.
                </p>
            </article>
        </section>
        <section class="links">
            <nav>
                <a href="https://soundcloud.com/sousto_tabor">soundcloud</a>
                <a href="https://www.instagram.com/sousto_tabor/">instagram</a>
                <a href="https://www.facebook.com/soustotabor">facebook</a>
                <a href="mailto:kolektiv@sousto.party">email</a>
            </nav>
        </section>
        <!--<img src="/soustik.svg" alt="Soustík" class="mascot">-->
    </main>
</Layout>

<style>

    .intro {
        height: 100vh;
        height: 100svh;
        background: black;

        & > video {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
    }

    .manifest {
        background: var(--color-primary);
        min-height: 100vh;
        display: grid;
        place-content: center;

        & > article {
            max-width: 40ch;
            margin-inline: auto;
            padding-inline: 24px;
            display: flex;
            flex-direction: column;
            gap: 32px;
        }

    }

    .links {
        background: black;
        color: var(--color-primary);
        min-height: 100vh;
        display: grid;
        place-content: center;
        text-align: center;
        gap: 32px;

        & a {
            color: inherit;
        }

        & > nav {
            display: flex;
            gap: 32px;

            @media (orientation: portrait) {
                flex-direction: column;
                gap: 12px;
            }
        }
    }

    @keyframes gramophone {
        0% {
            rotate: 0deg
        }
        100% {
            rotate: 360deg
        }
    }

    .title {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    .mascot {
        position: absolute;
        bottom: 0;
        left: 0;
    }
</style>
