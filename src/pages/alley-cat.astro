---
import Layout from '../layouts/Layout.astro';
---

<Layout title="alley cat | sousto">
    <main>
        <header>
            <p>sousto uvádí</p>
            <h1>
                <span>alley</span>
                <span>cat</span>
            </h1>
            <p>
                Troufneš si na trojboj, ve kterém rychlé nohy nestačí? Posbírej
                checkpointy, rozlouskni hádanku a ukaž techniku, důvtip i trochu
                štěstí ve finální festivalové challenge.
            </p>
        </header>

        <form id="alley-cat-form">
            <label for="full-name">
                jméno
                <input
                    id="full-name"
                    name="fi-sender-fullName"
                    type="text"
                    autocomplete="name"
                    required
                />
            </label>

            <label for="email">
                e-mail
                <input
                    id="email"
                    name="fi-sender-email"
                    type="email"
                    autocomplete="email"
                    required
                />
            </label>

            <button type="submit">registrovat</button>
            <p id="form-status" aria-live="polite"></p>
        </form>

        <a class="home" href="/">zpět na sousto</a>
    </main>
</Layout>

<script is:inline src="https://forminit.com/sdk/v1/forminit.js"></script>
<script is:inline>
    const form = document.getElementById('alley-cat-form');
    const status = document.getElementById('form-status');
    const button = form?.querySelector('button[type="submit"]');

    form?.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (!button || !status) return;

        const originalLabel = button.textContent;
        button.disabled = true;
        button.textContent = 'odesílám...';
        status.textContent = '';

        try {
            const ForminitClient = Reflect.get(window, 'Forminit');

            if (typeof ForminitClient !== 'function') {
                throw new Error('Forminit SDK is unavailable');
            }

            const forminit = new ForminitClient();
            const { redirectUrl, error } = await forminit.submit(
                'xvgl10ad5cy',
                new FormData(form),
            );

            if (error) throw new Error(error.message);

            window.location.assign(redirectUrl || '/diky');
        } catch (error) {
            console.error(error);
            status.textContent = 'Odeslání se nepodařilo. Zkus to prosím znovu.';
            button.disabled = false;
            button.textContent = originalLabel;
        }
    });
</script>

<style>
    main {
        width: min(100%, 1920px);
        min-height: 100svh;
        margin-inline: auto;
        padding: clamp(24px, 4vw, 64px);
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
        grid-template-rows: 1fr auto;
        gap: clamp(48px, 8vw, 160px);
        background: var(--color-primary);

        & header {
            align-self: center;
        }

        & header > p {
            font-size: clamp(24px, 3vw, 48px);
            letter-spacing: -0.02ex;
        }

        & h1 {
            margin-block: 0.12em;
            font-size: clamp(96px, 18vw, 320px);
            line-height: 0.72;
            letter-spacing: -0.11ex;
        }

        & h1 span {
            display: block;
        }

        & form {
            align-self: center;
            display: grid;
            gap: 0.8em;
        }

        & label {
            display: grid;
            gap: 0.12em;
        }

        & input,
        & button {
            min-width: 0;
            width: 100%;
            border: 0.08em solid black;
            border-radius: 0;
            font: inherit;
        }

        & input {
            padding: 0.5em 0.6em;
            background: transparent;
            color: black;
            font-size: 0.5em;
            letter-spacing: -0.01ex;
        }

        & button {
            padding: 0.3em 0.5em;
            background: black;
            color: var(--color-primary);
            cursor: pointer;
        }

        & button:disabled {
            cursor: wait;
            opacity: 0.7;
        }

        @media (hover: hover) {
            & button:not(:disabled):hover {
                border-color: blue;
                background: blue;
                color: white;
            }
        }

        & :is(input, button, a):focus-visible {
            outline: 0.1em solid blue;
            outline-offset: 0.12em;
        }

        & #form-status {
            min-height: 1.3em;
            font-size: 0.55em;
            letter-spacing: 0;
        }

        & .home {
            grid-column: 1 / -1;
            width: fit-content;
            color: blue;
        }

        @media (max-width: 900px) {
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: auto;
            align-content: center;
            gap: 1.5em;

            & h1 {
                font-size: clamp(96px, 34vw, 240px);
            }

            & input {
                font-size: 0.7em;
            }

            & .home {
                grid-column: auto;
            }
        }
    }
</style>
